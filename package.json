{
  "name": "recipeapp",
  "version": "1.0.0",
  "description": "Simple application for storing recipes (personal use)",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreezeMi/RecipeApp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/FreezeMi/RecipeApp/issues"
  },
  "homepage": "https://github.com/FreezeMi/RecipeApp#readme",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
