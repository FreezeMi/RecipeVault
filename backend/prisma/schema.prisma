// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon "-pooler" host) for application queries.
  url       = env("DATABASE_URL")
  // Direct connection for Prisma Migrate; PgBouncer's transaction mode breaks migrations.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Recipe {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  tags         String? // JSON array of strings
  prepTime     Int?
  cookTime     Int?
  servings     Int?
  imageUrl     String?
  sourceUrl    String?
  ingredients  String // JSON array of { quantity, unit, name }
  instructions String // JSON array of strings
  notes        String?
  language     String   @default("en") // language of the title, description, ingredients, instructions and notes
  translations String? // JSON object keyed by language: { "nl": { title, description, ingredients, instructions, notes } }
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
