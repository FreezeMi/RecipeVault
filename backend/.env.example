# Neon Postgres. Use the POOLED connection string (hostname contains "-pooler") for the app...
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# ...and the DIRECT connection string (same host without "-pooler") for Prisma Migrate.
# For a local database, set both to the same URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Port the API listens on.
PORT=3001

# Origin(s) of the frontend allowed to call the API (CORS + CSRF check).
# Comma-separate multiple origins, e.g. "https://myvault.vercel.app,http://localhost:5173".
FRONTEND_URL="http://localhost:5173"

# Secret used to sign session tokens. REQUIRED in production (the server refuses to start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="replace_with_a_long_random_string"

# Optional: Express "trust proxy" setting. Defaults to 1 in production (one proxy hop, e.g. Render).
# TRUST_PROXY=1
